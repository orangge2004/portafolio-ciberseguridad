PORT=3000
HOST=127.0.0.1

# Datos públicos para despliegues donde no viaja site.local.json.
# Se pueden definir por separado...
# SITE_NAME=Tu Nombre
# SITE_INITIALS=TN
# SITE_EMAIL=tu@email.com
# SITE_LOCATION=Tu ciudad · Remoto
#
# ...o todos a la vez con el mismo JSON del archivo site.local.json.
# SITE_LOCAL_JSON={"name":"Tu Nombre","initials":"TN","email":"tu@email.com","location":"Tu ciudad · Remoto","certifications":[]}
