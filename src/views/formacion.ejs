<% const completed = site.certifications.filter((c) => c.status === 'Completada'); %>
<% const totalHours = completed.reduce((sum, c) => sum + (c.hours ?? 0), 0); %>
<% const years = completed.map((c) => c.date?.slice(0, 4)).filter(Boolean).sort(); %>
<% const yearRange = years.length > 0 ? (years[0] === years[years.length - 1] ? years[0] : `${years[0]} – ${years[years.length - 1]}`) : '—'; %>
<% const issuers = [...new Set(completed.map((c) => c.issuer))].join(' · ') || '—'; %>

<%- include('partials/page-hero', {
  eyebrow: 'Formación',
  heading: 'Formación y aprendizaje continuo',
  lead: 'Certificaciones completadas, con su fecha, duración y diploma verificable. La formación sigue: aquí se irán añadiendo los próximos cursos cuando los termine.',
}) %>

<section class="section">
  <div class="container">
    <header class="section-head">
      <span class="section-head__index">01</span>
      <h2 class="section-head__title">Certificaciones</h2>
      <p class="section-head__sub">Cada tarjeta enlaza al diploma original y al perfil donde se puede comprobar la credencial.</p>
    </header>

    <% if (site.certifications.length > 0) { %>
      <div class="grid grid--4" aria-label="Resumen de formación">
        <div class="stat"><strong><%= completed.length %></strong><span><%= completed.length === 1 ? 'Certificación' : 'Certificaciones' %></span></div>
        <div class="stat"><strong><%= totalHours %> h</strong><span>De formación</span></div>
        <div class="stat"><strong><%= yearRange %></strong><span>Periodo</span></div>
        <div class="stat"><strong><%= issuers %></strong><span>Entidad emisora</span></div>
      </div>

      <div class="grid grid--2 mt-8">
        <% site.certifications.forEach((certification) => { %>
          <article class="card reveal">
            <div class="card__head">
              <span class="tag <%= certification.status === 'Completada' ? 'tag--accent' : '' %>"><%= certification.status %></span>
              <% if (certification.date) { %>
                <time class="card__index" datetime="<%= certification.date %>"><%= certification.date.slice(0, 4) %></time>
              <% } %>
            </div>
            <h3 class="card__title"><%= certification.name %></h3>
            <p><%= certification.focus %></p>
            <dl class="fact-list">
              <div><dt>Emisor</dt><dd><%= certification.issuer %></dd></div>
              <% if (certification.dateLabel) { %><div><dt>Fecha</dt><dd><%= certification.dateLabel %></dd></div><% } %>
              <% if (certification.hours) { %><div><dt>Duración</dt><dd><%= certification.hours %> horas</dd></div><% } %>
              <% if (certification.credentialId) { %><div><dt>Código</dt><dd class="mono"><%= certification.credentialId %></dd></div><% } %>
            </dl>
            <% if (certification.file || certification.credentialUrl) { %>
              <div class="hero__socials">
                <% if (certification.file) { %>
                  <a class="link" href="<%= certification.file %>" target="_blank" rel="noopener noreferrer">Ver diploma <span class="arrow" aria-hidden="true">↗</span></a>
                <% } %>
                <% if (certification.credentialUrl) { %>
                  <a class="link" href="<%= certification.credentialUrl %>" target="_blank" rel="noopener noreferrer">Verificar <span class="arrow" aria-hidden="true">↗</span></a>
                <% } %>
              </div>
            <% } %>
          </article>
        <% }) %>
      </div>
      <p class="disclosure">Los diplomas son los originales emitidos por cada plataforma. No se han modificado los datos ni las fechas de aprobación.</p>
    <% } else { %>
      <div class="empty-card">
        <span class="empty-card__icon" aria-hidden="true">+</span>
        <div class="stack">
          <h3>Aún no hay certificaciones publicadas</h3>
          <p>
            No quiero llenar esta sección con metas que todavía no he alcanzado.
            Cuando complete una certificación, aparecerá aquí con sus datos verificables.
          </p>
        </div>
      </div>
    <% } %>
  </div>
</section>

<section class="section section--elev">
  <div class="container">
    <header class="section-head">
      <span class="section-head__index">02</span>
      <h2 class="section-head__title">Ruta de aprendizaje</h2>
      <p class="section-head__sub">Sin fechas inventadas. Estas son las etapas que quiero completar y los temas que quiero entender antes de pasar a la siguiente.</p>
    </header>
    <%- include('partials/learning-path') %>
  </div>
</section>

<section class="section">
  <div class="container">
    <header class="section-head">
      <span class="section-head__index">03</span>
      <h2 class="section-head__title">Cómo mido el progreso</h2>
      <p class="section-head__sub">Sin métricas infladas. El progreso se ve en lo que puedo explicar y reproducir.</p>
    </header>
    <div class="grid grid--3">
      <% [
        ['Laboratorios completados', 'Cada ejercicio terminado se convierte en una entrada del portafolio.'],
        ['Writeups publicados', 'Si puedo explicar los pasos, puedo demostrar que lo he entendido.'],
        ['Autoevaluación', 'Anoto qué me costó, qué repasar y cuál es el siguiente paso.'],
      ].forEach(([title, text], i) => { %>
        <article class="card reveal">
          <span class="card__index">0<%= i + 1 %></span>
          <h3 class="card__title"><%= title %></h3>
          <p><%= text %></p>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<%- include('partials/cta') %>
