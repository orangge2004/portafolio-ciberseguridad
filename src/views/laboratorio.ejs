<section class="page-hero">
  <div class="bg-grid" aria-hidden="true"></div>
  <div class="container">
    <a class="back-link" href="/laboratorios"><span aria-hidden="true">←</span> Todos los laboratorios</a>
    <p class="eyebrow"><%= lab.category %> · <%= lab.date %></p>
    <h1><%= lab.title %></h1>
    <p class="lead"><%= lab.summary %></p>
    <ul class="tag-list page-hero__tags">
      <li class="tag tag--accent"><%= lab.platform %></li>
      <li class="tag"><%= lab.difficulty %></li>
    </ul>
  </div>
</section>

<section class="section">
  <div class="container split">
    <aside class="card sticky" aria-label="Ficha del laboratorio">
      <h2 class="card__title">Ficha del laboratorio</h2>
      <dl class="fact-list">
        <div><dt>Plataforma</dt><dd><%= lab.platform %></dd></div>
        <div><dt>Dificultad</dt><dd><%= lab.difficulty %></dd></div>
        <div><dt>Fecha</dt><dd><%= lab.date %></dd></div>
        <div><dt>Categoría</dt><dd><%= lab.category %></dd></div>
      </dl>
      <ul class="tag-list" aria-label="Herramientas">
        <% lab.tools.forEach((tool) => { %>
          <li class="tag"><%= tool %></li>
        <% }) %>
      </ul>
      <% if (lab.writeupUrl) { %>
        <a class="btn btn--primary btn--block" href="<%= lab.writeupUrl %>" target="_blank" rel="noopener noreferrer">Ver writeup completo</a>
      <% } %>
      <a class="btn <%= lab.writeupUrl ? 'btn--ghost' : 'btn--primary' %> btn--block" href="/contacto">Comentar este laboratorio</a>
    </aside>

    <article>
      <section class="case-section" aria-labelledby="objetivo-title">
        <p class="eyebrow">01 · Contexto</p>
        <h2 id="objetivo-title">Objetivo</h2>
        <p><%= lab.objective %></p>
      </section>

      <section class="case-section" aria-labelledby="entorno-title">
        <p class="eyebrow">02 · Entorno</p>
        <h2 id="entorno-title">Dónde practiqué</h2>
        <ul class="check-list">
          <% lab.environment.forEach((item) => { %><li><%= item %></li><% }) %>
        </ul>
      </section>

      <section class="case-section" aria-labelledby="pasos-title">
        <p class="eyebrow">03 · Proceso</p>
        <h2 id="pasos-title">Pasos seguidos</h2>
        <ol class="steps-list">
          <% lab.steps.forEach((step) => { %><li><%= step %></li><% }) %>
        </ol>
      </section>

      <section class="case-section" aria-labelledby="hallazgos-title">
        <p class="eyebrow">04 · Evidencia</p>
        <h2 id="hallazgos-title">Hallazgos</h2>
        <ul class="check-list">
          <% lab.findings.forEach((finding) => { %><li><%= finding %></li><% }) %>
        </ul>
      </section>

      <section class="case-section" aria-labelledby="aprendizajes-title">
        <p class="eyebrow">05 · Reflexión</p>
        <h2 id="aprendizajes-title">Aprendizajes</h2>
        <ul class="check-list">
          <% lab.lessons.forEach((lesson) => { %><li><%= lesson %></li><% }) %>
        </ul>
      </section>
    </article>
  </div>
</section>

<%- include('partials/cta') %>
