<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <meta name="description" content="<%= description %>">
  <meta name="theme-color" content="#0b0c0b">
  <meta name="color-scheme" content="dark light">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="es_ES">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta name="twitter:card" content="summary">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/space-grotesk-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/geist-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <%# Se carga antes del CSS para aplicar el tema guardado sin parpadeo. %>
  <script src="/js/theme.js?v=<%= assetVersion %>"></script>
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
  <script src="/js/main.js?v=<%= assetVersion %>" defer></script>
</head>
