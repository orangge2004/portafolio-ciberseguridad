<footer class="site-footer">
  <div class="container">
    <div class="site-footer__cols">
      <div>
        <p class="eyebrow site-footer__heading"><%= site.availability %></p>
        <p class="lead"><%= site.tagline %></p>
      </div>
      <nav aria-label="Navegación del pie">
        <p class="eyebrow site-footer__heading">Explorar</p>
        <ul class="site-footer__links">
          <% site.nav.forEach((item) => { %>
            <li><a href="<%= item.href %>"><%= item.label %></a></li>
          <% }) %>
        </ul>
      </nav>
      <div>
        <p class="eyebrow site-footer__heading">Contacto</p>
        <ul class="site-footer__links">
          <li><a href="mailto:<%= site.email %>"><%= site.email %></a></li>
          <li><%= site.location %></li>
          <% site.socials.forEach((social) => { %>
            <li><a href="<%= social.href %>" rel="noopener noreferrer" target="_blank"><%= social.label %> ↗</a></li>
          <% }) %>
        </ul>
      </div>
    </div>
    <div class="site-footer__wordmark" aria-hidden="true">
      <span><%= site.name %></span>
    </div>
  </div>
  <div class="container site-footer__bar">
    <span>© <%= year %> <%= site.name %></span>
    <span>Aprendizaje · Laboratorios · Seguridad ética</span>
    <a href="#contenido">Volver arriba ↑</a>
  </div>
</footer>
