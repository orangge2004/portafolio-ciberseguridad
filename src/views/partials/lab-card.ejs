<li class="post-row" data-category="<%= lab.filter %>">
  <span class="post-row__date"><%= lab.date %> · <%= lab.category %></span>
  <h3 class="post-row__title"><a href="/laboratorios/<%= lab.slug %>"><%= lab.title %></a></h3>
  <span class="tag"><%= lab.platform %> · <%= lab.difficulty %></span>
  <span class="post-row__arrow" aria-hidden="true">↗</span>
</li>
