<section class="page-hero error-page">
  <div class="container">
    <p class="error-code" aria-hidden="true">500</p>
    <h1>Algo ha fallado.</h1>
    <p class="lead">
      Ha ocurrido un error inesperado. Puedes volver al inicio o escribirme
      directamente si el problema persiste.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/">Volver al inicio</a>
      <a class="btn btn-secondary" href="mailto:<%= site.email %>">Escribir un correo</a>
    </div>
  </div>
</section>
