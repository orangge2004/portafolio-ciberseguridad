<section class="page-hero">
  <div class="bg-grid" aria-hidden="true"></div>
  <div class="container">
    <p class="display-mega error-code" aria-hidden="true">500</p>
    <h1>Algo ha fallado</h1>
    <p class="lead">
      Ha ocurrido un error inesperado. Puedes volver al inicio o escribirme
      directamente si el problema persiste.
    </p>
    <div class="page-hero__actions">
      <a class="btn btn--primary" href="/">Volver al inicio <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href="mailto:<%= site.email %>">Escribir un correo</a>
    </div>
  </div>
</section>
