<%- include('partials/page-hero', {
  eyebrow: 'Laboratorios',
  heading: 'Ejercicios prácticos y writeups',
  lead: site.projects.length > 0
    ? 'Laboratorios completados en entornos autorizados: objetivo, entorno, pasos y aprendizajes de cada uno.'
    : 'Aquí publicaré los laboratorios que complete: objetivo, entorno, pasos y aprendizajes. Ahora mismo no hay ninguno publicado.',
}) %>

<section class="section">
  <div class="container">
    <% if (site.projects.length > 0) { %>
      <div class="filters">
        <div class="filter-group" role="group" aria-label="Filtrar laboratorios por categoría">
          <% [['all', 'Todos'], ['web', 'Web'], ['linux', 'Linux'], ['windows', 'Windows'], ['network', 'Redes'], ['ctf', 'CTF']].forEach(([value, label], i) => { %>
            <button class="filter-button" type="button" data-filter="<%= value %>" aria-pressed="<%= i === 0 %>"><%= label %></button>
          <% }) %>
        </div>
        <p class="eyebrow eyebrow--plain">
          <%= site.projects.length %> <%= site.projects.length === 1 ? 'laboratorio publicado' : 'laboratorios publicados' %>
        </p>
      </div>

      <ul class="post-list">
        <% site.projects.forEach((lab) => { %>
          <%- include('partials/lab-card', { lab }) %>
        <% }) %>
      </ul>

      <p class="disclosure" data-empty hidden>No hay laboratorios en esta categoría.</p>
    <% } else { %>
      <div class="empty-card">
        <span class="empty-card__icon" aria-hidden="true">+</span>
        <div class="stack">
          <h2>Todavía no hay laboratorios publicados</h2>
          <p>
            Esta sección está vacía a propósito. Estoy preparando los primeros
            ejercicios y los añadiré aquí cuando los complete.
          </p>
          <div class="hero__actions">
            <a class="btn btn--primary" href="/practicas">Ver áreas de práctica <span class="arrow" aria-hidden="true">→</span></a>
            <a class="btn btn--ghost" href="/contacto">Sugerir un recurso</a>
          </div>
        </div>
      </div>
    <% } %>
    <p class="disclosure">
      Todos los ejercicios se realizan en entornos propios o en plataformas que
      permiten la práctica. No se publican datos sensibles ni información de
      sistemas de terceros.
    </p>
  </div>
</section>

<section class="section section--elev">
  <div class="container">
    <header class="section-head">
      <span class="section-head__index">01</span>
      <h2 class="section-head__title">Qué incluye cada writeup</h2>
      <p class="section-head__sub">Un ejercicio sin contexto no sirve para aprender. Por eso cada publicación sigue esta estructura.</p>
    </header>
    <div class="grid grid--4">
      <% [
        ['Objetivo', 'Qué quería practicar y por qué elegí ese ejercicio.'],
        ['Entorno', 'Máquina, plataforma o aplicación vulnerable utilizada, siempre autorizada.'],
        ['Pasos', 'El proceso seguido, incluyendo los callejones sin salida.'],
        ['Aprendizajes', 'Qué he entendido y qué haría distinto la próxima vez.'],
      ].forEach(([title, text], i) => { %>
        <article class="card reveal">
          <span class="card__index">0<%= i + 1 %></span>
          <h3 class="card__title"><%= title %></h3>
          <p><%= text %></p>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<%- include('partials/cta') %>
