<% const topics = [...new Set(site.learningPath.flatMap((stage) => stage.topics))]; %>
<% const completedCerts = site.certifications.filter((c) => c.status === 'Completada'); %>
<% const featuredLabs = site.projects.filter((lab) => lab.featured); %>
<% const homeLabs = featuredLabs.length > 0 ? featuredLabs : site.projects.slice(0, 4); %>

<section class="hero">
  <div class="bg-grid" aria-hidden="true"></div>
  <div class="container">
    <div class="hero__top">
      <span class="status"><span class="status__dot" aria-hidden="true"></span><%= site.availability %></span>
      <span class="eyebrow"><%= site.role %> · <%= site.location %></span>
    </div>

    <h1 class="hero__title display-mega">
      <span class="line"><span>Aprendo</span></span>
      <span class="line"><span class="is-accent">hacking</span></span>
      <span class="line"><span class="is-outline">ético</span></span>
    </h1>

    <div class="hero__bottom">
      <div>
        <p class="lead">
          Documento mi progreso en seguridad ofensiva: fundamentos, laboratorios
          y writeups de ejercicios resueltos en entornos autorizados. Un
          laboratorio a la vez.
        </p>
        <% if (site.socials.length > 0) { %>
          <div class="hero__socials">
            <% site.socials.forEach((social) => { %>
              <a class="link" href="<%= social.href %>" target="_blank" rel="noopener noreferrer"><%= social.label %> <span class="arrow" aria-hidden="true">↗</span></a>
            <% }) %>
          </div>
        <% } %>
      </div>
      <div class="hero__actions">
        <a class="btn btn--primary btn--lg" href="/laboratorios">Ver laboratorios <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost btn--lg" href="/practicas">Áreas de práctica</a>
      </div>
    </div>
  </div>
</section>

<div class="marquee">
  <div class="marquee__track">
    <% topics.forEach((topic) => { %><span><%= topic %></span><% }) %>
  </div>
  <div class="marquee__track" aria-hidden="true">
    <% topics.forEach((topic) => { %><span><%= topic %></span><% }) %>
  </div>
</div>

<section class="section">
  <div class="container">
    <header class="section-head">
      <span class="section-head__index">01</span>
      <h2 class="section-head__title">Cuaderno de campo</h2>
    </header>
    <div class="split">
      <div class="stack prose reveal">
        <p class="lead">
          Este portafolio no vende servicios: es el registro público de lo que
          practico, cómo lo hago y qué aprendo en cada ejercicio.
        </p>
        <p>
          Solo trabajo en máquinas propias o en plataformas que permiten la
          práctica. Cada writeup sigue el mismo método para que otra persona
          pueda entenderlo y reproducirlo.
        </p>
        <a class="link" href="/sobre-mi">Más sobre mí <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="terminal reveal">
        <div class="terminal__bar">
          <div class="terminal__dots" aria-hidden="true"><span></span><span></span><span></span></div>
          <span class="terminal__title">~/portafolio</span>
        </div>
        <div class="terminal__body"><pre><span class="prompt">$</span>whoami
<span class="tk-ok"><%= site.role.toLowerCase() %></span>
<span class="prompt">$</span>cat metodo.md
<span class="tk-com"># Cómo documento cada ejercicio</span>
<span class="tk-key">1.</span> Objetivo y entorno autorizado
<span class="tk-key">2.</span> Pasos reproducibles y comandos
<span class="tk-key">3.</span> Herramientas y evidencias
<span class="tk-key">4.</span> Hallazgos y dificultades
<span class="tk-key">5.</span> Referencias para repasar
<span class="prompt">$</span><span class="cursor"></span></pre></div>
      </div>
    </div>

    <div class="grid grid--4 mt-8">
      <% site.focus.forEach((item, i) => { %>
        <article class="skill-card reveal">
          <span class="skill-card__icon mono" aria-hidden="true"><%= ['>_', '#!', '</>', '¶'][i % 4] %></span>
          <h3 class="skill-card__title"><%= item.title %></h3>
          <p class="muted"><%= item.description %></p>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<section class="section section--elev">
  <div class="container">
    <header class="section-head">
      <span class="section-head__index">02</span>
      <h2 class="section-head__title">Qué estoy aprendiendo</h2>
      <a class="link section-head__aside" href="/practicas">Todas las áreas <span class="arrow" aria-hidden="true">→</span></a>
    </header>
    <div class="grid grid--3">
      <% site.practiceAreas.forEach((area) => { %>
        <article class="card">
          <span class="card__index">A/<%= area.index %></span>
          <h3 class="card__title"><a class="card__link" href="/practicas#<%= area.slug %>"><%= area.title %></a></h3>
          <p><%= area.summary %></p>
          <span class="card__foot">Ver área <span aria-hidden="true">→</span></span>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<section class="section section--invert">
  <div class="container">
    <header class="section-head">
      <span class="section-head__index">03</span>
      <h2 class="section-head__title">De la práctica al writeup</h2>
    </header>
    <ol class="process" role="list">
      <li class="process__step"><h3 class="process__title">Entorno</h3><p class="process__text">Máquinas propias o plataformas que permiten laboratorios.</p></li>
      <li class="process__step"><h3 class="process__title">Objetivo</h3><p class="process__text">Qué quiero practicar y qué evidencia quiero obtener.</p></li>
      <li class="process__step"><h3 class="process__title">Práctica</h3><p class="process__text">Comandos, resultados y decisiones anotados mientras resuelvo.</p></li>
      <li class="process__step"><h3 class="process__title">Writeup</h3><p class="process__text">Un resumen reproducible y lo que haría distinto.</p></li>
    </ol>
    <div class="grid grid--3 mt-8">
      <div class="stat"><strong>Reproducible</strong><span>Si no puedo explicarlo, no lo publico</span></div>
      <div class="stat"><strong>Ético</strong><span>Solo con autorización explícita</span></div>
      <div class="stat"><strong>Honesto</strong><span>También lo que todavía no sé</span></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <header class="section-head">
      <span class="section-head__index">04</span>
      <h2 class="section-head__title">Laboratorios y writeups</h2>
      <a class="link section-head__aside" href="/laboratorios">Ver todos <span class="arrow" aria-hidden="true">→</span></a>
    </header>
    <% if (homeLabs.length > 0) { %>
      <ul class="post-list">
        <% homeLabs.forEach((lab) => { %>
          <%- include('partials/lab-card', { lab }) %>
        <% }) %>
      </ul>
    <% } else { %>
      <div class="empty-card">
        <span class="empty-card__icon" aria-hidden="true">+</span>
        <div class="stack">
          <h3>El primer laboratorio está en preparación</h3>
          <p>
            Esta sección está vacía a propósito. A medida que complete ejercicios,
            añadiré el objetivo, el entorno, los pasos y los aprendizajes de cada uno.
          </p>
          <a class="link" href="/contacto">Sugerir un recurso <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    <% } %>
  </div>
</section>

<section class="section section--elev">
  <div class="container">
    <header class="section-head">
      <span class="section-head__index">05</span>
      <h2 class="section-head__title">Formación</h2>
      <a class="link section-head__aside" href="/formacion">Ver formación <span class="arrow" aria-hidden="true">→</span></a>
    </header>
    <div class="split">
      <ol class="timeline" role="list">
        <% site.learningPath.forEach((stage) => { %>
          <li class="timeline__item">
            <span class="timeline__date">Etapa <%= stage.stage %></span>
            <div>
              <h3 class="timeline__org"><%= stage.title %></h3>
              <p class="timeline__role"><%= stage.description %></p>
            </div>
          </li>
        <% }) %>
      </ol>
      <div class="grid">
        <% if (completedCerts.length > 0) { %>
          <% completedCerts.forEach((certification) => { %>
            <div class="cert">
              <span class="cert__name"><strong><%= certification.name %></strong><br><span class="muted"><%= certification.issuer %><% if (certification.dateLabel) { %> · <%= certification.dateLabel %><% } %></span></span>
              <span class="cert__state tag tag--accent">Completada</span>
            </div>
          <% }) %>
        <% } else { %>
          <p class="lead">
            Sin fechas ni certificaciones inventadas. Este es el plan que sigo y
            lo iré actualizando con lo que complete.
          </p>
        <% } %>
      </div>
    </div>
  </div>
</section>

<%- include('partials/cta') %>
