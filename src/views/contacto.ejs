<%- include('partials/page-hero', {
  eyebrow: 'Contacto',
  heading: 'Hablemos',
  lead: 'Si quieres darme feedback sobre un ejercicio, proponer una colaboración o compartir un recurso, escríbeme. Estoy aprendiendo y cualquier comentario ayuda.',
}) %>

<section class="section">
  <div class="container split">
    <div class="stack">
      <a class="link" href="mailto:<%= site.email %>"><%= site.email %> <span class="arrow" aria-hidden="true">↗</span></a>
      <dl class="fact-list">
        <div><dt>Ubicación</dt><dd><%= site.location %></dd></div>
        <div><dt>Estado</dt><dd><%= site.availability %></dd></div>
        <div><dt>Respuesta</dt><dd><%= site.responseTime %></dd></div>
        <% site.socials.forEach((social) => { %>
          <div><dt><%= social.label %></dt><dd><a href="<%= social.href %>" target="_blank" rel="noopener noreferrer"><%= social.href.replace(/^https?:\/\//, '') %> ↗</a></dd></div>
        <% }) %>
      </dl>

      <h2 class="h3 mt-7">Puedes escribirme para</h2>
      <ul class="check-list">
        <li>Darme feedback sobre un writeup o una nota.</li>
        <li>Recomendarme un recurso, laboratorio o lectura.</li>
        <li>Proponer una práctica o colaboración.</li>
        <li>Compartir una oportunidad de aprendizaje.</li>
      </ul>

      <p class="disclosure">
        Transparencia: no ofrezco servicios profesionales de auditoría ni
        pentesting. Este portafolio documenta mi aprendizaje y mis prácticas en
        entornos autorizados.
      </p>
    </div>

    <form class="form card" id="contact-form" data-email="<%= site.email %>" novalidate>
      <div>
        <h2 class="h3">Enviar un mensaje</h2>
        <p class="form__note mt-4">
          Este formulario no envía datos a ningún servidor: prepara el mensaje en
          tu cliente de correo para que tú decidas cuándo enviarlo.
        </p>
      </div>

      <fieldset class="field chips-field">
        <legend class="field__label">Motivo *</legend>
        <div class="chips mt-4">
          <% ['Feedback sobre un laboratorio', 'Recomendación de un recurso', 'Colaboración o práctica conjunta', 'Oportunidad de aprendizaje', 'Otra consulta'].forEach((reason, i) => { %>
            <input type="radio" name="service" id="motivo-<%= i %>" value="<%= reason %>" required <%= i === 0 ? 'checked' : '' %>><label for="motivo-<%= i %>"><%= reason %></label>
          <% }) %>
        </div>
      </fieldset>

      <div class="form__row">
        <label class="field"><span class="field__label">Nombre *</span><input class="field__input" id="name" name="name" type="text" autocomplete="name" required></label>
        <label class="field"><span class="field__label">Email *</span><input class="field__input" id="email" name="email" type="email" autocomplete="email" required></label>
      </div>
      <label class="field"><span class="field__label">Empresa u organización</span><input class="field__input" id="company" name="company" type="text" autocomplete="organization"></label>
      <label class="field"><span class="field__label">Mensaje *</span><textarea class="field__textarea" id="message" name="message" rows="6" required placeholder="Cuéntame brevemente el motivo de tu mensaje."></textarea></label>

      <div>
        <button class="btn btn--primary btn--lg" type="submit">Preparar mensaje <span class="arrow" aria-hidden="true">→</span></button>
      </div>
      <p class="form__status" id="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
