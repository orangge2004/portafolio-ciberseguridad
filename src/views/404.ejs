<section class="page-hero">
  <div class="bg-grid" aria-hidden="true"></div>
  <div class="container">
    <p class="display-mega error-code" aria-hidden="true">404</p>
    <h1>Esta página no existe</h1>
    <p class="lead">
      Puede que el enlace haya cambiado o que la dirección esté mal escrita. Estas
      son las rutas principales del sitio.
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    <ul class="post-list">
      <% site.nav.forEach((item, i) => { %>
        <li class="post-row">
          <span class="post-row__date"><%= String(i + 1).padStart(2, '0') %></span>
          <h2 class="post-row__title"><a href="<%= item.href %>"><%= item.label %></a></h2>
          <span></span>
          <span class="post-row__arrow" aria-hidden="true">→</span>
        </li>
      <% }) %>
    </ul>
  </div>
</section>
